<UserControl x:Class="Client.Views.RealtimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Client.Models"
             xmlns:prism="http://prismlibrary.com/" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="White"
             d:DesignHeight="600" d:DesignWidth="900">
    <!--
    binding 看源和路径
    HierarchicalDataTemplate 有子节点 ItemSource DataTemplate 没有子节点
    DataType TypeA 如果渲染对象是 TypeA，按照定义的模板进行渲染
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <!--左侧设备树-->
        <DockPanel Grid.Column="0">
            <TextBlock Text="设备导航"
                       DockPanel.Dock="Top"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="10,10"/>

            <TreeView ItemsSource="{Binding ProductionLineTreeNodes}" Margin="5">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectedItemChanged">
                        <i:InvokeCommandAction Command="{Binding SelectedItemChangedCommand}"
                                               CommandParameter="{Binding SelectedItem,RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                    </i:EventTrigger> 
                </i:Interaction.Triggers>
                
                <TreeView.Resources>
                    <!--产线节点模板，有子节点-->
                    <HierarchicalDataTemplate DataType="{x:Type local:ProductionLineTreeNode}"
                                              ItemsSource="{Binding Devices}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    </HierarchicalDataTemplate>

                    <!--设备节点模板 没有子节点-->
                     <DataTemplate DataType="{x:Type local:DeviceTreeNode}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Height="10" Width="10"
                                     Fill="{Binding StatusColor}"
                                     VerticalAlignment="Center"
                                     Margin="0,5,5,0"/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel> 
                     </DataTemplate>
                </TreeView.Resources>
            </TreeView>
        </DockPanel>

        <!-- 右侧：实时数据面板 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!--第一行：实时数据面板-->
             <Grid Grid.Column="1" Margin="10">
                 <!-- 未选择设备时显示占位 -->
                 <TextBlock Text="请在左侧选择一个设备查看实时数据"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="#999"
                            Visibility="{Binding IsDeviceNotSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                 <!-- 选中设备后显示数据 -->
                 <StackPanel Visibility="{Binding IsDeviceSelected,Converter={StaticResource BooleanToVisibilityConverter}}" >
                     <!-- 设备标题栏 -->
                     <DockPanel>
                         <TextBlock Text="{Binding SelectedDeviceName}" 
                                    FontSize="18" FontWeight="Bold" Margin="0,0,20,0"/>
                         <TextBlock DockPanel.Dock="Right" Text="{Binding DeviceStatus}" 
                                    Foreground="#666" VerticalAlignment="Center"
                                    FontWeight="Bold" FontSize="15"/>
                     </DockPanel>

                     <!-- 测点卡片列表 -->
                     <ItemsControl ItemsSource="{Binding DataPoints}">
                         <ItemsControl.ItemsPanel>
                             <ItemsPanelTemplate>
                                 <UniformGrid Columns="3" />
                             </ItemsPanelTemplate>
                         </ItemsControl.ItemsPanel>
             
                         <ItemsControl.ItemTemplate>
                             <DataTemplate>
                                 <Border Margin="5" Padding="12" 
                                         Background="#FAFAFA" 
                                         BorderBrush="#E0E0E0" BorderThickness="1"
                                         CornerRadius="4">
                                     <StackPanel>
                                         <TextBlock Text="{Binding Name}" 
                                                    FontSize="12" Foreground="#666" Margin="0,0,0,6" />
                             
                                         <StackPanel Orientation="Horizontal">                           
                                             <TextBlock Text="{Binding DisplayValue}" 
                                                        FontSize="22" FontWeight="Bold">
                                                 <TextBlock.Foreground>
                                                     <SolidColorBrush Color="{Binding ValueColor}" />
                                                 </TextBlock.Foreground>
                                             </TextBlock>
                                 
                                             <TextBlock Text="{Binding Unit}" 
                                                        FontSize="12" Foreground="#999" 
                                                        VerticalAlignment="Bottom" Margin="4,0,0,2" />
                                         </StackPanel>
                             
                                         <!-- 报警状态指示 -->
                                         <TextBlock Text="{Binding AlarmText}" 
                                                    FontSize="10" Margin="0,4,0,0">
                                             <TextBlock.Foreground>
                                                 <SolidColorBrush Color="{Binding AlarmColor}" />
                                             </TextBlock.Foreground>
                                         </TextBlock>
                                     </StackPanel>
                                 </Border>
                             </DataTemplate>
                         </ItemsControl.ItemTemplate>
                     </ItemsControl>
         
                 </StackPanel>
             </Grid>

            <!--第二行：实时趋势曲线-->
            <Grid Grid.Row="1" Visibility="{Binding IsDeviceSelected,Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Orientation="Horizontal"
                            Margin="10"
                            Grid.Row="0">
                    <TextBlock Text="选择测点："
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding TrendPointNames}"
                              SelectedItem="{Binding SelectedTrendPoint}"
                              Width="120"
                              VerticalAlignment="Center" /> 
                </StackPanel>

                <lvc:CartesianChart Grid.Row="1"
                                    Series="{Binding TrendSeries}"
                                    XAxes="{Binding TrendXAxes}"
                                    YAxes="{Binding TrendYAxes}"/>

            </Grid>
        </Grid>
    </Grid>
</UserControl>