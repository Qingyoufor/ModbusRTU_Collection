<UserControl x:Class="Client.Modules.DeviceMangement.Views.DeviceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Client.Modules.DeviceMangement.Views"
             mc:Ignorable="d" 
             Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
     <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：新增按钮 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="刷新"
                    Command="{Binding RefreshCommand}"
                    Width="100" Height="30" />
            <Button Content="新增设备" 
                    Command="{Binding CreateCommand}"
                    Width="100" Height="30"
                    HorizontalAlignment="Right"/>
        </DockPanel>

        <!-- 设备列表表格 -->
        <DataGrid Grid.Row="1" 
                  Style="{StaticResource MinimalDataGridStyle}"
                  ItemsSource="{Binding Devices}"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Width="60" Binding="{Binding Id}" />
                <DataGridTextColumn Header="设备名称" Width="*" Binding="{Binding Name}" />
                <DataGridTextColumn Header="设备编码" Width="120" Binding="{Binding Code}" />
                <DataGridTextColumn Header="状态" Width="80" Binding="{Binding Status}" />
                <DataGridTextColumn Header="所属产线" Width="*" Binding="{Binding ProductionLineName}" />
                <DataGridTemplateColumn Header="操作" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!--Button 的 DataContex 变为Devices[0],这时上下文变了，需要写 RelativeSource-->
                                <Button Content="编辑" Margin="2" Width="50" Height="25"
                                        Command="{Binding DataContext.EditCommand, 
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Id}" />
                                <Button Content="删除" Margin="2" Width="50" Height="25"
                                        Command="{Binding DataContext.DeleteCommand, 
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Id}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分页控件（简单按钮实现） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="上一页" Width="80" Height="25" Margin="5"
                    Command="{Binding PrevPageCommand}" />
            <TextBlock Text="{Binding PageInfo}" 
                       VerticalAlignment="Center" Margin="10,0" />
            <Button Content="下一页" Width="80" Height="25" Margin="5"
                    Command="{Binding NextPageCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
